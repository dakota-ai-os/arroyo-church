<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.arroyo.sermonnotes</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/dakotayates/ai-os/ventures/arroyo-church-redesign/scripts/run-sermon-notes.sh</string>
    </array>

    <!-- SATURDAY NIGHT, SEVERAL ATTEMPTS (Dakota, 2026-10-17).
         The note should be ready Saturday night. Josh emails the outline to av@ during
         the week or on Saturday and sometimes sends a correction late Saturday (10/10 at
         22:07), so there are three Saturday-night attempts: 20:00, 21:30 and 23:00. A later
         attempt republishes only if a NEWER outline arrived (the marker stores which email
         was published); otherwise it stands down, so the series graphic isn't touched twice.

         Several attempts on purpose (2026-09-09): launchd can fire during a Power Nap dark
         wake or with the screen locked, where Notes can't be driven. The script detects that
         in ~0.2s and exits 75 without touching the note, and the next attempt tries again.
         The Sunday 06:45 / 08:00 / 09:00 slots are a fallback for a Saturday night where the
         Mac was locked or asleep; they stand down if Saturday already published. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- If the Mac was asleep at a scheduled time, run as soon as it wakes rather than
         skipping the slot entirely. -->
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/dakotayates/Library/Logs/arroyo-sermon-notes.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dakotayates/Library/Logs/arroyo-sermon-notes.out.log</string>
</dict>
</plist>
